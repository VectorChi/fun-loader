  "extends": "../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@/components/ui/fun-loader": ["./fun-loader/fun-loader.tsx"],
      "@/lib/utils": ["./lib/utils.ts"]
    }
  },
  "include": ["."],
  "exclude": []
}
