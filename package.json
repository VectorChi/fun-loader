{
  "name": "@vectorchi/fun-loader",
  "version": "0.5.0",
  "description": "Playful, rotating loading messages for AI and LLM apps. A tiny web component with React and Vue wrappers.",
  "license": "MIT",
  "author": "Adim (https://github.com/VectorChi)",
  "homepage": "https://vectorchi.github.io/fun-loader/",
  "bugs": {
    "url": "https://github.com/VectorChi/fun-loader/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VectorChi/fun-loader.git"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "loader",
    "loading",
    "loading-indicator",
    "loading-text",
    "spinner",
    "typing-indicator",
    "ai",
    "llm",
    "chatbot",
    "chatgpt",
    "streaming",
    "react",
    "nextjs",
    "vue"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/vue/index.js",
    "./dist/fun-loader.iife.js",
    "./src/index.ts",
    "./src/vue/index.ts",
    "./dist/react/index.js",
    "./src/react/index.ts"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "unpkg": "./dist/fun-loader.iife.js",
  "jsdelivr": "./dist/fun-loader.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "default": "./dist/themes/*.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./custom-elements.json": "./custom-elements.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node scripts/use-client.mjs",
    "dev": "tsup --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "size": "size-limit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@phosphor-icons/core": "^2.1.1",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.14.0",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "packageManager": "pnpm@9.15.9"
}
